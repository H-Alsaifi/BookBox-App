<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.theme.RateBook">


    <Button
        android:id="@+id/saveRating"
        android:layout_width="131dp"
        android:layout_height="57dp"
        android:layout_marginTop="56dp"
        android:gravity="center_vertical"
        android:text="Save Rating"
        app:layout_constraintTop_toBottomOf="@+id/bookRating"
        tools:layout_editor_absoluteX="140dp" />

    <EditText
        android:id="@+id/bookTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:text="Book Name: "
        tools:layout_editor_absoluteX="100dp"
        tools:layout_editor_absoluteY="85dp" />

    <RatingBar
        android:id="@+id/bookRating"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        app:layout_constraintTop_toBottomOf="@+id/bookTitle"
        tools:layout_editor_absoluteX="85dp" />

    <RatingBar
        android:id="@+id/avgRatingValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        app:layout_constraintTop_toBottomOf="@+id/avgRating"
        tools:layout_editor_absoluteX="85dp" />

    <TextView
        android:id="@+id/avgRating"
        android:layout_width="156dp"
        android:layout_height="44dp"
        android:layout_marginTop="52dp"
        android:text="Average Rating: "
        android:textSize="20dp"
        app:layout_constraintTop_toBottomOf="@+id/saveRating"
        tools:layout_editor_absoluteX="127dp" />
</androidx.constraintlayout.widget.ConstraintLayout>